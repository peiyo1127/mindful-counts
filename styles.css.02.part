    .result{padding:18px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center}
    .result-title{font:400 17px/1.45 var(--serif)}
    .result-meta{font:400 11px/1.5 var(--sans);color:var(--muted);margin-top:4px}
    .import-btn{border:1px solid rgba(0,0,0,.12);background:rgba(255,255,255,.38);border-radius:16px;padding:8px 13px;font:500 12px var(--sans)}
    .preview-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:2px 0 14px}
    .preview-source{font:500 10px var(--sans);letter-spacing:.02em;color:#6f7567;background:rgba(156,163,138,.14);padding:6px 9px;border-radius:12px}
    .preview-body{position:relative;max-height:54dvh;overflow:auto;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:22px 2px 26px;margin:4px 0 22px;white-space:pre-wrap;font:300 16px/2 var(--serif);letter-spacing:.02em;scrollbar-width:none}
    .preview-body::-webkit-scrollbar{display:none}
    .preview-loading{padding:80px 0;text-align:center;color:var(--muted);font:300 16px/1.8 var(--serif)}
    .preview-actions{position:sticky;bottom:0;padding-top:10px;background:linear-gradient(180deg,rgba(247,244,236,0),var(--paper) 24%)}
    .empty{padding:54px 0;text-align:center;color:var(--muted);font:300 16px/1.8 var(--serif)}

    .field{margin:0 0 22px}
    .field label{display:block;font:400 13px/1.5 var(--sans);margin-bottom:8px}
    .field input,.field textarea{width:100%;border:1px solid rgba(0,0,0,.10);background:rgba(255,255,255,.40);border-radius:14px;padding:13px 14px;outline:none;font:300 15px/1.8 var(--serif);resize:vertical}
    .field textarea{min-height:210px}
    .field.dedication textarea{min-height:120px}
    .field small{display:block;text-align:right;margin-top:6px;color:var(--muted);font:400 11px var(--sans)}
    .primary{width:100%;border:0;background:linear-gradient(90deg,#aa8c7b,#d48566);color:#fff;border-radius:18px;padding:14px 16px;font:400 15px var(--sans);margin:6px 0 10px}
    .secondary{width:100%;border:1px solid rgba(0,0,0,.12);background:rgba(255,255,255,.34);border-radius:18px;padding:14px 16px;font:400 14px var(--sans)}
    .source-chip{display:inline-block;padding:5px 8px;border-radius:12px;background:rgba(156,163,138,.14);font:500 10px var(--sans);color:#5d6558;margin-bottom:10px}

    .library-item{border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 38px;align-items:stretch}
    .library-item:last-child{border-bottom:1px solid var(--line)}
    .library-open{border:0;background:transparent;padding:17px 0;text-align:left;display:grid;grid-template-columns:1fr auto;align-items:center;min-width:0}
    .library-item .name{font:300 19px/1.4 var(--serif)}
    .library-item .meta{font:400 11px/1.5 var(--sans);color:var(--muted);margin-top:4px}
    .library-item .arrow{font:300 28px var(--latin);padding-right:4px}
    .item-menu{border:0;background:transparent;color:#8b837b;font:500 17px/1 var(--sans);letter-spacing:1px;padding:0;align-self:stretch}
    .item-menu:active{opacity:.45}

    .counter-screen{overflow:auto;padding-bottom:0;scroll-behavior:smooth}
    .counter-screen .content{min-height:calc(100dvh - 52px - env(safe-area-inset-top));display:flex;flex-direction:column}
    .counter-title{text-align:center;font:300 21px/1.3 var(--serif);margin-top:12px}
    .counter-visual{position:relative;flex:1;min-height:450px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding-bottom:118px}
    .counter-glow-coral{width:330px;height:250px;left:50%;top:54%;transform:translate(-50%,-50%);filter:blur(38px);opacity:.80}
    .counter-glow-sage{width:190px;height:160px;right:-80px;top:62%;filter:blur(30px);opacity:.55}
    .count-number{position:relative;z-index:2;font:300 112px/.82 var(--latin);letter-spacing:-4px}
    .count-unit{position:relative;z-index:2;font:300 17px/1 var(--serif);margin-top:15px}
    .count-hit{position:relative;z-index:2;margin-top:58px;border:0;width:116px;height:116px;border-radius:50%;background:rgba(139,108,94,.77);color:#fff;font:200 70px/.8 var(--latin);box-shadow:0 10px 30px rgba(80,50,40,.10);backdrop-filter:blur(8px)}
    .time-block{position:absolute;z-index:3;bottom:125px;text-align:center}
    .elapsed{font:300 27px/1.2 var(--latin)}
    .session-range{font:400 11px/1.5 var(--sans);color:#77736e;margin-top:4px}
    .control-dock{position:absolute;z-index:4;left:-26px;right:-26px;bottom:-1px;height:112px;background:linear-gradient(90deg,rgba(203,208,191,.44),rgba(255,255,255,.38),rgba(203,208,191,.28));backdrop-filter:blur(15px);border-top-left-radius:50% 28px;border-top-right-radius:50% 28px;border-top:1px solid rgba(255,255,255,.46);display:grid;grid-template-columns:1fr 1fr 1fr;align-items:start;padding:22px 50px 0}
